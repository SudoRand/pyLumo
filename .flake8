[flake8]
max-line-length = 100
extend-ignore = E501, W503, E402, E203, E127
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .tox,
    .pytest_cache

# E501: line too long (handled by max-line-length)
# W503: line break before binary operator (conflicts with PEP 8)
# E402: module level import not at top of file (needed for some imports after warnings filters)
# E203: whitespace before ':' (conflicts with black formatting)
# E127: continuation line over-indented (conflicts with black formatting)
